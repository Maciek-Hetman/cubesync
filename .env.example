APP_ENV=development
API_BIND=0.0.0.0
API_PORT=43781
PUBLIC_URL=http://127.0.0.1:43781
# Deep-link or web-app base used in verification/reset emails.
CLIENT_URL=cubetimer://auth
POSTGRES_PASSWORD=development-password
DATABASE_URL=postgres://cubetimer:development-password@127.0.0.1:5432/cubetimer?sslmode=disable
# Generate with: openssl rand -base64 48
JWT_SECRET=development-only-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
ALLOWED_ORIGINS=http://127.0.0.1:43210

# Comma-separated audience/client IDs accepted from each platform.
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM value; in Compose use a quoted multiline value or a secret file.
APPLE_PRIVATE_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CubeTimer <noreply@localhost>
SMTP_STARTTLS=true
# Never enable in production: verification/reset URLs contain secrets.
LOG_ONE_TIME_LINKS=true

MAX_SYNC_MUTATIONS=500
MAX_SYNC_CHANGES=1000
